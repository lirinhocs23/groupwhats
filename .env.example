# Copie para .env na VM: cp .env.example .env && nano .env

PORT=3000
TZ=America/Sao_Paulo

# Persistência (recomendado na Oracle — pasta fora do git)
WWEBJS_AUTH_PATH=/data/groupwhats/wwebjs_auth
DATABASE_PATH=/data/groupwhats/db/db_saas.json

# Chromium do sistema (Dockerfile / Ubuntu apt)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Gemini (moderação IA)
GEMINI_API_KEY=sua_chave_1,sua_chave_2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash
GEMINI_RETRY_MAX=3
GEMINI_RETRY_DELAY_MS=1500

# Podagem do banco — só server.js / Railway (db_saas.json)
DB_PRUNE_ZERO_HOURS=8
DB_PRUNE_MAX_NAME=60

# index.js (pm2 start index.js) usa GEMINI_* + dotenv lê este arquivo na raiz.
# Não commite .env — está no .gitignore.
